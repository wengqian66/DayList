<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DayList.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DayList">
    <Grid x:Name="ShellRoot" Background="{StaticResource SoftCreamBrush}" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="108" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TrafficLights"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    AutomationProperties.Name="关闭"
                    Background="#FF5F57"
                    Click="ChromeClose_Click"
                    Content="×"
                    Style="{StaticResource TrafficLightStyle}"
                    ToolTipService.ToolTip="关闭" />
                <Button
                    AutomationProperties.Name="最小化"
                    Background="#FFFEBC2E"
                    Click="ChromeMin_Click"
                    Content="–"
                    Style="{StaticResource TrafficLightStyle}"
                    ToolTipService.ToolTip="最小化" />
                <Button
                    x:Name="ZoomLight"
                    AutomationProperties.Name="最大化"
                    Background="#FF28C840"
                    Click="ChromeZoom_Click"
                    Content="+"
                    Style="{StaticResource TrafficLightStyle}"
                    ToolTipService.ToolTip="最大化" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SoftInkBrush}"
                Text="设置" />
            <Border
                Grid.ColumnSpan="3"
                Height="1"
                VerticalAlignment="Bottom"
                Background="#14000000"
                IsHitTestVisible="False" />
        </Grid>
        <Grid Grid.Row="1" Padding="18,8,18,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource SoftMutedInkBrush}"
                    Text="任务只写进每日笔记。这里配置库位置、桌面行为和 AI 接口。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="4" Padding="0,4,6,10">

                    <local:SoftCard Padding="4,2,4,10">
                    <Border Style="{StaticResource SoftSettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SoftSettingsSectionTitleStyle}" Text="库" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="库文件夹" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VaultBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="例如 D:\Notes\Vault" TextChanged="FieldChanged" />
                                <Button Grid.Column="1" Click="Browse_Click" Content="浏览…" CornerRadius="10" />
                            </Grid>
                            <Button HorizontalAlignment="Left" Click="ReadObsidian_Click" Content="从库设置读取" CornerRadius="10" />
                            <TextBlock
                                x:Name="HintText"
                                FontSize="12"
                                Foreground="{StaticResource SoftMutedInkBrush}"
                                Text="如果你已经在 Obsidian 开了每日笔记，可以从 .obsidian/daily-notes.json 带出文件夹和格式。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </local:SoftCard>

                    <local:SoftCard Padding="4,2,4,10">
                    <Border Style="{StaticResource SoftSettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SoftSettingsSectionTitleStyle}" Text="每日笔记" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="子文件夹" />
                            <TextBox x:Name="FolderBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="空表示库根目录，例如 Daily" TextChanged="FieldChanged" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="留空时笔记就在库根目录。格式里如果已经写了文件夹，这里也可以空。" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="文件名格式" />
                            <TextBox x:Name="PatternBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="YYYY-MM-DD" TextChanged="FieldChanged" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="Obsidian 用 YYYY-MM-DD，.NET 用 yyyy-MM-dd；也可以写成 Daily/YYYY-MM-DD。" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="灵感小节" />
                            <TextBox x:Name="InspirationBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="灵感" TextChanged="FieldChanged" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="今日任务上方会列出当天已记下的句子。点某一条，或侧栏「灵感」，可以改、删或再写一句。记在当天笔记的这个小节（默认「灵感」）。不是待办，不进已完成，不进月报，也不参与生成计划。" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </local:SoftCard>

                    <local:SoftCard Padding="4,2,4,10">
                    <Border Style="{StaticResource SoftSettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SoftSettingsSectionTitleStyle}" Text="桌面交互" />
                            <CheckBox x:Name="AlwaysOnTopBox" Content="窗口置顶" Foreground="{StaticResource SoftInkBrush}" />
                            <CheckBox x:Name="MinimizeToTrayBox" Content="关闭窗口时最小化到托盘（托盘可退出）" Foreground="{StaticResource SoftInkBrush}" />
                            <CheckBox x:Name="StartMinimizedBox" Content="启动时先最小化到托盘" Foreground="{StaticResource SoftInkBrush}" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="全局热键" />
                            <TextBox x:Name="HotkeyBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="点击后按下组合键" IsReadOnly="True" KeyDown="HotkeyBox_KeyDown" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="默认 Ctrl+Shift+D：显示窗口并聚焦添加框。支持 Ctrl/Shift/Alt + 字母或 F1–F12。" TextWrapping="Wrap" />
                            <CheckBox x:Name="ReminderSoundBox" Content="提醒时播放提示音" Foreground="{StaticResource SoftInkBrush}" />
                            <CheckBox x:Name="ReminderToastOnlyBox" Content="只用系统通知，不弹出窗口" Foreground="{StaticResource SoftInkBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="任务行右侧铃铛可滚动选择时间。提醒需要 DayList 正在运行（最小化到托盘即可）。退出或重启后系统不会补响。再次打开时，12 小时内错过的会补一次。" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </local:SoftCard>

                    <local:SoftCard Padding="4,2,4,10">
                    <Border Style="{StaticResource SoftSettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SoftSettingsSectionTitleStyle}" Text="AI（月报 / 自然语言计划）" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="月报子文件夹" />
                            <TextBox x:Name="ReportFolderBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="Reports" TextChanged="FieldChanged" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="月报文件名格式" />
                            <TextBox x:Name="ReportPatternBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="yyyy-MM" TextChanged="FieldChanged" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="接口 Base URL" />
                            <TextBox x:Name="ApiUrlBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="https://api.openai.com/v1" TextChanged="FieldChanged" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="填到 /v1 为止。也可用本地接口。月报与「用自然语言生成计划」共用这套配置。" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="API Key" />
                            <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource SoftPasswordBoxStyle}" PlaceholderText="不会写进笔记" PasswordChanged="PasswordChanged" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Text="密钥以明文保存在本机 %AppData%\DayList\settings.json。" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SoftSettingsLabelStyle}" Text="模型" />
                            <TextBox x:Name="ModelBox" Style="{StaticResource SoftSettingsFieldStyle}" PlaceholderText="gpt-4o-mini" TextChanged="FieldChanged" />
                            <TextBlock x:Name="PreviewText" FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </local:SoftCard>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="#FFB33A3A" TextWrapping="Wrap" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="88" Click="Cancel_Click" Content="取消" CornerRadius="12" />
                    <Button MinWidth="88" Click="Save_Click" Content="保存" Style="{StaticResource AccentButtonStyle}" CornerRadius="12" />
                </StackPanel>
            </Grid>
        </Grid>
        <Border
            x:Name="WindowOutline"
            Grid.RowSpan="2"
            BorderBrush="#24000000"
            BorderThickness="1"
            CornerRadius="12"
            IsHitTestVisible="False" />
    </Grid>
</Window>
