<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DayList.QuickAddWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource SoftCardBrush}">
        <StackPanel Padding="20,14,20,14" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Foreground="{StaticResource SoftAccentBrush}" Glyph="&#xE710;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SoftInkBrush}"
                        Text="快速添加" />
                    <Button
                        x:Name="ModeChip"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource SoftAmberBrush}"
                        BorderThickness="0"
                        Click="ExitAiMode_Click"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="点击退出 AI 模式">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                x:Name="ModeChipText"
                                FontSize="12"
                                Foreground="{StaticResource SoftAmberInkBrush}"
                                Text="AI 生成计划" />
                            <FontIcon FontSize="10" Foreground="{StaticResource SoftAmberInkBrush}" Glyph="&#xE711;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Text="回车保存 · Esc 取消" />
                    <Button
                        Width="32"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="关闭"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Close_Click"
                        CornerRadius="10"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Glyph="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBox
                x:Name="Input"
                MinHeight="46"
                AcceptsReturn="False"
                Background="{StaticResource SoftCreamBrush}"
                BorderBrush="{StaticResource SoftLineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,0"
                FontSize="16"
                VerticalContentAlignment="Center"
                PlaceholderForeground="{StaticResource SoftPlaceholderBrush}"
                KeyDown="Input_KeyDown"
                PlaceholderText="写点什么…" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="DateButton"
                    Padding="10,6"
                    Background="{StaticResource SoftCreamBrush}"
                    BorderBrush="{StaticResource SoftLineBrush}"
                    BorderThickness="1"
                    Click="DateButton_Click"
                    CornerRadius="10"
                    ToolTipService.ToolTip="任务日期">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Foreground="{StaticResource SoftAccentBrush}" Glyph="&#xE787;" />
                        <TextBlock x:Name="DateLabel" FontSize="13" Foreground="{StaticResource SoftInkBrush}" Text="今天" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="TimeButton"
                    Padding="10,6"
                    Background="{StaticResource SoftCreamBrush}"
                    BorderBrush="{StaticResource SoftLineBrush}"
                    BorderThickness="1"
                    Click="TimeButton_Click"
                    CornerRadius="10"
                    ToolTipService.ToolTip="设定提醒时间">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Foreground="{StaticResource SoftAccentBrush}" Glyph="&#xE823;" />
                        <TextBlock x:Name="TimeLabel" FontSize="13" Foreground="{StaticResource SoftInkBrush}" Text="时间" />
                    </StackPanel>
                </Button>
                <ComboBox
                    x:Name="CategoryPicker"
                    Height="34"
                    MinWidth="96"
                    MaxWidth="140"
                    VerticalAlignment="Center"
                    Style="{StaticResource SoftComboBoxStyle}"
                    ToolTipService.ToolTip="任务分类" />
                <Button
                    x:Name="AiButton"
                    Padding="10,6"
                    Background="{StaticResource SoftCreamBrush}"
                    BorderBrush="{StaticResource SoftLineBrush}"
                    BorderThickness="1"
                    Click="AiButton_Click"
                    CornerRadius="10"
                    ToolTipService.ToolTip="用 AI 把一段话拆成任务">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Foreground="{StaticResource SoftAccentBrush}" Glyph="&#xE9F5;" />
                        <TextBlock FontSize="13" Foreground="{StaticResource SoftInkBrush}" Text="AI 生成计划" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock
                x:Name="HintText"
                FontSize="12"
                Foreground="{StaticResource SoftMutedInkBrush}"
                Text="回车保存；日期、时间、分类用上面的按钮设置。"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{StaticResource SoftMutedInkBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="TimePane"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource SoftMutedInkBrush}"
                    Text="时间" />
                <ComboBox
                    x:Name="HourPicker"
                    Width="72"
                    Height="34"
                    Style="{StaticResource SoftComboBoxStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource SoftInkBrush}"
                    Text=":" />
                <ComboBox
                    x:Name="MinutePicker"
                    Width="72"
                    Height="34"
                    Style="{StaticResource SoftComboBoxStyle}" />
                <Button
                    Margin="8,0,0,0"
                    Click="TimeClear_Click"
                    Content="清除"
                    CornerRadius="10" />
                <Button Click="TimeCancel_Click" Content="取消" CornerRadius="10" />
                <Button Click="TimeOk_Click" Content="确定" CornerRadius="10" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
