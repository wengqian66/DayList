<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DayList.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DayList">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SoftCreamColor">#FFF7F2EA</Color>
                    <Color x:Key="SoftCreamDeepColor">#FFF0E8DC</Color>
                    <Color x:Key="SoftCardColor">#FFFFFBF6</Color>
                    <Color x:Key="SoftInkColor">#FF3D3429</Color>
                    <Color x:Key="SoftMutedInkColor">#FF6B5F52</Color>
                    <Color x:Key="SoftLineColor">#FFE4D8C8</Color>
                    <Color x:Key="SoftAmberColor">#FFF3E0C4</Color>
                    <Color x:Key="SoftAmberInkColor">#FF8A5A20</Color>
                    <Color x:Key="SoftNavSelectedColor">#FFE7D9C4</Color>
                    <Color x:Key="SoftPlaceholderColor">#666B5F52</Color>
                    <!-- Activity heatmap: five warm steps, empty → busiest -->
                    <Color x:Key="SoftHeat0Color">#FFF0E8DC</Color>
                    <Color x:Key="SoftHeat1Color">#FFEBDCBE</Color>
                    <Color x:Key="SoftHeat2Color">#FFDFC08D</Color>
                    <Color x:Key="SoftHeat3Color">#FFC89552</Color>
                    <Color x:Key="SoftHeat4Color">#FF8A5A20</Color>
                    <Color x:Key="SoftHeatLineColor">#55E4D8C8</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SoftCreamColor">#FF2B2621</Color>
                    <Color x:Key="SoftCreamDeepColor">#FF241F1B</Color>
                    <Color x:Key="SoftCardColor">#FF38322B</Color>
                    <Color x:Key="SoftInkColor">#FFEDE4D6</Color>
                    <Color x:Key="SoftMutedInkColor">#FFA9988A</Color>
                    <Color x:Key="SoftLineColor">#FF4C443B</Color>
                    <Color x:Key="SoftAmberColor">#FF4A3A22</Color>
                    <Color x:Key="SoftAmberInkColor">#FFD9A96B</Color>
                    <Color x:Key="SoftNavSelectedColor">#FF4A423A</Color>
                    <Color x:Key="SoftPlaceholderColor">#66A9988A</Color>
                    <Color x:Key="SoftHeat0Color">#FF2E2822</Color>
                    <Color x:Key="SoftHeat1Color">#FF4A3A22</Color>
                    <Color x:Key="SoftHeat2Color">#FF6E5227</Color>
                    <Color x:Key="SoftHeat3Color">#FF9A6C33</Color>
                    <Color x:Key="SoftHeat4Color">#FFD9A96B</Color>
                    <Color x:Key="SoftHeatLineColor">#55554A3F</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="SoftCreamBrush" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="SoftCreamDeepBrush" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="SoftCardBrush" Color="{ThemeResource SoftCardColor}" />
            <SolidColorBrush x:Key="SoftInkBrush" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="SoftMutedInkBrush" Color="{ThemeResource SoftMutedInkColor}" />
            <SolidColorBrush x:Key="SoftLineBrush" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="SoftAmberBrush" Color="{ThemeResource SoftAmberColor}" />
            <SolidColorBrush x:Key="SoftAmberInkBrush" Color="{ThemeResource SoftAmberInkColor}" />
            <SolidColorBrush x:Key="SoftNavSelectedBrush" Color="{ThemeResource SoftNavSelectedColor}" />
            <SolidColorBrush x:Key="SoftPlaceholderBrush" Color="{ThemeResource SoftPlaceholderColor}" />
            <SolidColorBrush x:Key="SoftHeat0Brush" Color="{ThemeResource SoftHeat0Color}" />
            <SolidColorBrush x:Key="SoftHeat1Brush" Color="{ThemeResource SoftHeat1Color}" />
            <SolidColorBrush x:Key="SoftHeat2Brush" Color="{ThemeResource SoftHeat2Color}" />
            <SolidColorBrush x:Key="SoftHeat3Brush" Color="{ThemeResource SoftHeat3Color}" />
            <SolidColorBrush x:Key="SoftHeat4Brush" Color="{ThemeResource SoftHeat4Color}" />
            <SolidColorBrush x:Key="SoftHeatLineBrush" Color="{ThemeResource SoftHeatLineColor}" />

            <!-- Typography tokens -->
            <FontFamily x:Key="DayListBodyFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
            <FontFamily x:Key="DayListMonoFont">Cascadia Mono, Consolas</FontFamily>
            <x:Double x:Key="TextSizeCaption">12</x:Double>
            <x:Double x:Key="TextSizeSecondary">13</x:Double>
            <x:Double x:Key="TextSizeBody">14</x:Double>
            <x:Double x:Key="TextSizeSection">15</x:Double>
            <x:Double x:Key="TextSizeHeading">16</x:Double>
            <x:Double x:Key="TextSizeTitle">22</x:Double>
            <x:Double x:Key="TextSizeDisplay">26</x:Double>

            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="PillCornerRadius">22</CornerRadius>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="SoftIconButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource SoftMutedInkBrush}" />
            </Style>

            <Style x:Key="TaskTextStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>

            <Style x:Key="CategoryChipStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SoftCreamDeepBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{StaticResource SoftMutedInkBrush}" />
            </Style>

            <!-- Text chips size to their label. QuietButtonStyle's fixed 36px width clips 「全部」. -->
            <Style x:Key="SoftChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SoftAmberInkBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,5,12,5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SoftAmberInkBrush}" />
            </Style>

            <Style x:Key="SoftCategoryCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>

            <!-- White card: layered shadow, 120ms pointer lift. Not the window chrome. -->
            <Style x:Key="SoftLiftCardStyle" TargetType="local:SoftCard">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,4,8,16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:SoftCard">
                            <Grid x:Name="Root" Padding="{TemplateBinding Padding}">
                                <Grid x:Name="LiftRoot">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="Lift" />
                                    </Grid.RenderTransform>
                                    <Grid x:Name="ShadowHost" IsHitTestVisible="False" />
                                    <ContentPresenter
                                        x:Name="Face"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Lift"
                                                    Storyboard.TargetProperty="Y"
                                                    To="0"
                                                    Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Lift"
                                                    Storyboard.TargetProperty="Y"
                                                    To="-4"
                                                    Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SoftNavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,11" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="40" />
            </Style>


            <Style x:Key="QuietSectionTitleBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="MaxWidth" Value="160" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="SelectionHighlightColor" Value="#665B9BD5" />
            </Style>
            <Style x:Key="SoftSettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="SoftSettingsSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>
            <Style x:Key="SoftSettingsLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>
            <Style x:Key="SoftSettingsFieldStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>

            <!-- Soft overlays: dialogs, flyouts, calendar, infobars -->
            <SolidColorBrush x:Key="SoftDialogScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="SoftAccentBrush" Color="#FF5B9BD5" />
            <SolidColorBrush x:Key="SoftCalendarChromeBrush" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="SoftCalendarDayBrush" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="SoftCalendarMarkedBrush" Color="{ThemeResource SoftAmberColor}" />
            <SolidColorBrush x:Key="SoftInfoBarSuccessBrush" Color="{ThemeResource SoftCardColor}" />
            <SolidColorBrush x:Key="SoftInfoBarWarningBrush" Color="{ThemeResource SoftAmberColor}" />
            <SolidColorBrush x:Key="SoftInfoBarErrorBrush" Color="{ThemeResource SoftCardColor}" />
            <SolidColorBrush x:Key="SoftInfoBarInformationalBrush" Color="{ThemeResource SoftCardColor}" />

            <Style x:Key="SoftDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <Style x:Key="SoftDialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamDeepBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <Style x:Key="SoftContentDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>
            <Style TargetType="ContentDialog" BasedOn="{StaticResource SoftContentDialogStyle}" />

            <Style x:Key="SoftFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource SoftCalendarChromeBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftCalendarViewStyle" TargetType="CalendarView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="OutOfScopeForeground" Value="{StaticResource SoftMutedInkBrush}" />
                <Setter Property="CalendarItemForeground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="CalendarItemBackground" Value="Transparent" />
                <Setter Property="CalendarItemBorderBrush" Value="Transparent" />
                <Setter Property="SelectedBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="SelectedHoverBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="SelectedPressedBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="TodayForeground" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="HoverBorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="PressedBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="DayItemFontSize" Value="13" />
                <Setter Property="MonthYearItemFontSize" Value="13" />
                <Setter Property="FirstDayOfWeek" Value="Monday" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftInfoBarStyle" TargetType="InfoBar">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>
            <Style TargetType="InfoBar" BasedOn="{StaticResource SoftInfoBarStyle}" />

            <Style x:Key="SoftPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{ThemeResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>


            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundFocused" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{ThemeResource SoftInkColor}" />

            <!-- Cream button interaction states: replace default gray/blue hover & pressed -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SoftMutedInkColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00FFFFFF" />

            <!-- Force ComboBox popup off acrylic white -->
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerPressed" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="{ThemeResource SoftCreamColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{ThemeResource SoftNavSelectedColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="{ThemeResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="{ThemeResource SoftInkColor}" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#FF5B9BD5" />

            <Style x:Key="SoftComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <!-- Trash sits beside the name. Less vertical padding keeps the row near the old text height. -->
            <Style x:Key="CategoryPickerItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource SoftComboBoxItemStyle}">
                <Setter Property="Padding" Value="10,2,8,2" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style x:Key="SoftComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="RequestedTheme" Value="Light" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboBoxItemStyle}" />
            </Style>


            <SolidColorBrush x:Key="SoftPinCheckedBrush" Color="{ThemeResource SoftNavSelectedColor}" />
            <SolidColorBrush x:Key="SoftPinCheckedBorderBrush" Color="{ThemeResource SoftLineColor}" />
            <SolidColorBrush x:Key="SoftPinCheckedForegroundBrush" Color="{ThemeResource SoftMutedInkColor}" />

            <Style x:Key="SoftPinToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource SoftMutedInkBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource SoftCreamDeepBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource SoftPinCheckedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource SoftPinCheckedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource SoftPinCheckedBorderBrush}" />
                                                <Setter Target="Root.BorderThickness" Value="1" />
                                                <Setter Target="Root.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SoftPillComposerStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
