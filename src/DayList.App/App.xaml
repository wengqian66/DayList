<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DayList.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SoftCreamColor">#FFF5F5F7</Color>
            <Color x:Key="SoftCreamDeepColor">#FFE8E8ED</Color>
            <Color x:Key="SoftCardColor">#FFFFFFFF</Color>
            <Color x:Key="SoftInkColor">#FF1D1D1F</Color>
            <Color x:Key="SoftMutedInkColor">#993C3C43</Color>
            <Color x:Key="SoftLineColor">#1A000000</Color>
            <Color x:Key="SoftAmberColor">#FFFFF4E8</Color>
            <Color x:Key="SoftAmberInkColor">#FFC93400</Color>
            <Color x:Key="SoftNavSelectedColor">#1A007AFF</Color>
            <Color x:Key="MacBlueColor">#FF007AFF</Color>
            <Color x:Key="MacFieldColor">#FFE8E8ED</Color>

            <SolidColorBrush x:Key="SoftCreamBrush" Color="{StaticResource SoftCreamColor}" />
            <SolidColorBrush x:Key="SoftCreamDeepBrush" Color="{StaticResource SoftCreamDeepColor}" />
            <SolidColorBrush x:Key="SoftCardBrush" Color="{StaticResource SoftCardColor}" />
            <SolidColorBrush x:Key="SoftInkBrush" Color="{StaticResource SoftInkColor}" />
            <SolidColorBrush x:Key="SoftMutedInkBrush" Color="{StaticResource SoftMutedInkColor}" />
            <SolidColorBrush x:Key="SoftLineBrush" Color="{StaticResource SoftLineColor}" />
            <SolidColorBrush x:Key="SoftAmberBrush" Color="{StaticResource SoftAmberColor}" />
            <SolidColorBrush x:Key="SoftAmberInkBrush" Color="{StaticResource SoftAmberInkColor}" />
            <SolidColorBrush x:Key="SoftNavSelectedBrush" Color="{StaticResource SoftNavSelectedColor}" />
            <SolidColorBrush x:Key="MacBlueBrush" Color="{StaticResource MacBlueColor}" />
            <SolidColorBrush x:Key="MacFieldBrush" Color="{StaticResource MacFieldColor}" />

            <x:Double x:Key="ScrollBarSize">6</x:Double>
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#66000000" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#99000000" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B3000000" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#66000000" />

            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </Style>

            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="PillCornerRadius">22</CornerRadius>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="SoftIconButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource SoftMutedInkBrush}" />
            </Style>

            <Style x:Key="TaskTextStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>

            <Style x:Key="CategoryChipStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource MacFieldBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource SoftMutedInkBrush}" />
            </Style>

            <Style x:Key="SoftCategoryCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="SoftNavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,11" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="40" />
            </Style>


            <Style x:Key="QuietSectionTitleBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="MaxWidth" Value="160" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="SelectionHighlightColor" Value="#66007AFF" />
            </Style>
            <Style x:Key="SoftSettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,16" />
            </Style>
            <Style x:Key="SoftSettingsSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>
            <Style x:Key="SoftSettingsLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>
            <Style x:Key="SoftSettingsFieldStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource MacFieldBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>

            <!-- Soft overlays: dialogs, flyouts, calendar, infobars -->
            <SolidColorBrush x:Key="SoftDialogScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="SoftAccentBrush" Color="#FF007AFF" />
            <SolidColorBrush x:Key="SoftCalendarChromeBrush" Color="#FFE0D2C0" />
            <SolidColorBrush x:Key="SoftCalendarDayBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="SoftInfoBarSuccessBrush" Color="#FFE5F0D8" />
            <SolidColorBrush x:Key="SoftInfoBarWarningBrush" Color="#FFF3E0C4" />
            <SolidColorBrush x:Key="SoftInfoBarErrorBrush" Color="#FFF3D6D2" />
            <SolidColorBrush x:Key="SoftInfoBarInformationalBrush" Color="#FFE0EAF4" />

            <Style x:Key="SoftDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <Style x:Key="SoftDialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamDeepBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <Style x:Key="SoftContentDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>
            <Style TargetType="ContentDialog" BasedOn="{StaticResource SoftContentDialogStyle}" />

            <Style x:Key="SoftFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource SoftCalendarChromeBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftCalendarViewStyle" TargetType="CalendarView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="OutOfScopeForeground" Value="{StaticResource SoftMutedInkBrush}" />
                <Setter Property="CalendarItemForeground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="CalendarItemBackground" Value="Transparent" />
                <Setter Property="CalendarItemBorderBrush" Value="Transparent" />
                <Setter Property="SelectedBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="SelectedHoverBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="SelectedPressedBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="TodayForeground" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="HoverBorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="PressedBorderBrush" Value="{StaticResource SoftAccentBrush}" />
                <Setter Property="DayItemFontSize" Value="13" />
                <Setter Property="MonthYearItemFontSize" Value="13" />
                <Setter Property="FirstDayOfWeek" Value="Monday" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftInfoBarStyle" TargetType="InfoBar">
                <Setter Property="Background" Value="{StaticResource SoftCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>
            <Style TargetType="InfoBar" BasedOn="{StaticResource SoftInfoBarStyle}" />

            <Style x:Key="SoftPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource MacFieldBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
            </Style>


            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#FFE8E8ED" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundFocused" Color="#FFE8E8ED" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FF1D1D1F" />

            <!-- Force ComboBox popup off acrylic white -->
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="#FFE8E8ED" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerPressed" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FFE8E8ED" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FFE5E5EA" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FFE8E8ED" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FFDCDCE2" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#FFE8E8ED" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#FF007AFF" />

            <Style x:Key="SoftComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="Background" Value="{StaticResource SoftCreamBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="RequestedTheme" Value="Light" />
            </Style>

            <Style x:Key="SoftComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{StaticResource MacFieldBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
                <Setter Property="RequestedTheme" Value="Light" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboBoxItemStyle}" />
            </Style>


            <SolidColorBrush x:Key="SoftPinCheckedBrush" Color="#1A007AFF" />
            <SolidColorBrush x:Key="SoftPinCheckedBorderBrush" Color="#66007AFF" />
            <SolidColorBrush x:Key="SoftPinCheckedForegroundBrush" Color="#FF007AFF" />

            <Style x:Key="SoftPinToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource SoftMutedInkBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource SoftCreamDeepBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource SoftPinCheckedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource SoftPinCheckedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource SoftPinCheckedBorderBrush}" />
                                                <Setter Target="Root.BorderThickness" Value="1" />
                                                <Setter Target="Root.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SoftPillComposerStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MacFieldBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <Style x:Key="TrafficLightStyle" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#FF5F57" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="20" Height="20" Background="Transparent">
                                <Ellipse
                                    x:Name="Dot"
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding Background}" />
                                <TextBlock
                                    x:Name="Glyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Variable Text, Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#CC1D1D1F"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    Text="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Glyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Glyph.Opacity" Value="1" />
                                                <Setter Target="Dot.Opacity" Value="0.72" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Dot.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MacCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="Ring"
                                        Stroke="#59000000"
                                        StrokeThickness="1.25"
                                        Fill="Transparent" />
                                    <Ellipse
                                        x:Name="Fill"
                                        Fill="#FF007AFF"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="FillScale" ScaleX="0.7" ScaleY="0.7" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <FontIcon
                                        x:Name="Mark"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="9"
                                        Foreground="White"
                                        Glyph="&#xE73E;"
                                        Opacity="0" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Stroke" Value="#99000000" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="0.4" />
                                                <Setter Target="Fill.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="0.7" Duration="0:0:0.2" EnableDependentAnimation="True" />
                                                <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="0.7" Duration="0:0:0.2" EnableDependentAnimation="True" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" EnableDependentAnimation="True" />
                                                <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" EnableDependentAnimation="True" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource MacCheckBoxStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
