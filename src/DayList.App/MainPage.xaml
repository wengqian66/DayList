<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DayList.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DayList"
    Background="{StaticResource SoftCreamBrush}"
    RequestedTheme="Light"
    UseLayoutRounding="True">
    <Page.Resources>
        <!-- Page namescope, not a code-created storyboard. Begin() on a
             storyboard whose target cannot be resolved originates 0x800F1000
             and WinUI fail-fasts the process. -->
        <Storyboard x:Key="CelebrationStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CelebrationBanner" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.08" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.54" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="ProgressPulseStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SideProgressHostScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SideProgressHostScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="local:TaskRow">
            <Grid
                Padding="4,3"
                AllowDrop="True"
                Background="{x:Bind RowBackground, Mode=OneWay}"
                ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
                ColumnSpacing="6"
                MinHeight="36"
                ContextRequested="TaskRow_ContextRequested"
                DragOver="TaskRow_DragOver"
                Drop="TaskRow_Drop"
                Holding="TaskRow_Holding"
                PointerEntered="TaskRow_PointerEntered"
                PointerExited="TaskRow_PointerExited"
                RightTapped="TaskRow_RightTapped">
                <Border
                    Width="18"
                    Height="32"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CanDrag="True"
                    DragStarting="DragHandle_DragStarting"
                    ToolTipService.ToolTip="拖动手柄排序。拖到别的分类卡片上可改类">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Glyph="&#xE784;" />
                </Border>
                <CheckBox
                    Grid.Column="1"
                    MinWidth="28"
                    VerticalAlignment="Center"
                    Checked="TaskDoneChanged"
                    Foreground="{StaticResource SoftInkBrush}"
                    IsChecked="{x:Bind IsDone, Mode=OneWay}"
                    Unchecked="TaskDoneChanged" />
                <Border Grid.Column="2" Width="{x:Bind IndentWidth, Mode=OneWay}" />
                <TextBox
                    Grid.Column="3"
                    ContextRequested="TaskRow_ContextRequested"
                    GotFocus="TaskText_GotFocus"
                    Holding="TaskRow_Holding"
                    KeyDown="TaskText_KeyDown"
                    KeyUp="TaskText_KeyUp"
                    LostFocus="TaskText_LostFocus"
                    Opacity="{x:Bind TextOpacity, Mode=OneWay}"
                    RightTapped="TaskRow_RightTapped"
                    Style="{StaticResource TaskTextStyle}"
                    Text="{x:Bind Text, Mode=TwoWay}"
                    TextWrapping="NoWrap" />
                <Button
                    Grid.Column="4"
                    MaxWidth="96"
                    VerticalAlignment="Center"
                    Click="CategoryChip_Click"
                    Content="{x:Bind CategoryLabel, Mode=OneWay}"
                    Style="{StaticResource CategoryChipStyle}"
                    ToolTipService.ToolTip="更改分类" />
                <Button
                    Grid.Column="5"
                    MinWidth="44"
                    Width="Auto"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="设置提醒"
                    Click="Remind_Click"
                    Style="{StaticResource QuietButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ReminderToolTip, Mode=OneWay}">
                    <Grid>
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource SoftMutedInkBrush}"
                            Glyph="&#xEA8F;"
                            Visibility="{x:Bind ReminderIconVisibility, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource SoftInkBrush}"
                            Text="{x:Bind ReminderTime, Mode=OneWay}"
                            Visibility="{x:Bind ReminderTimeVisibility, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button
                    Grid.Column="6"
                    AutomationProperties.Name="删除任务"
                    Click="Delete_Click"
                    Opacity="0.28"
                    Style="{StaticResource QuietButtonStyle}"
                    Tag="delete">
                    <FontIcon FontSize="12" Foreground="{StaticResource SoftMutedInkBrush}" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="local:CategoryCardModel">
            <local:SoftCard Style="{StaticResource SoftLiftCardStyle}">
                <Border
                    AllowDrop="True"
                    Background="{StaticResource SoftCardBrush}"
                    BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                    BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                    CornerRadius="16"
                    DragOver="Header_DragOver"
                    Drop="Header_Drop"
                    Padding="16,14,14,8"
                    ToolTipService.ToolTip="拖到卡片上可改分类">
                    <StackPanel Spacing="2">
                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{x:Bind AccentBrush, Mode=OneTime}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SoftInkBrush}"
                                Text="{x:Bind Title, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource SoftMutedInkBrush}"
                                Text="{x:Bind FractionText, Mode=OneWay}" />
                            <Grid
                                Grid.Column="3"
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    Width="32"
                                    Height="32"
                                    Foreground="{x:Bind AccentBrush, Mode=OneTime}"
                                    IsIndeterminate="False"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SoftInkBrush}"
                                    Text="{x:Bind ProgressLabel, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                        <ItemsControl
                            ItemTemplate="{StaticResource TaskItemTemplate}"
                            ItemsSource="{x:Bind Tasks, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </local:SoftCard>
        </DataTemplate>

        <!-- Completed view: same grouping, no progress ring or N/N score. -->
        <DataTemplate x:Key="CompletedCardTemplate" x:DataType="local:CategoryCardModel">
            <local:SoftCard Padding="8,2,8,12" Style="{StaticResource SoftLiftCardStyle}">
                <Border
                    AllowDrop="True"
                    Background="{StaticResource SoftCardBrush}"
                    BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                    BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                    CornerRadius="16"
                    DragOver="Header_DragOver"
                    Drop="Header_Drop"
                    Padding="16,12,14,8"
                    ToolTipService.ToolTip="拖到卡片上可改分类">
                    <StackPanel Spacing="2">
                        <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{x:Bind AccentBrush, Mode=OneTime}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SoftInkBrush}"
                                Text="{x:Bind Title, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource SoftMutedInkBrush}"
                                Text="{x:Bind CountText, Mode=OneWay}" />
                        </Grid>
                        <ItemsControl
                            ItemTemplate="{StaticResource TaskItemTemplate}"
                            ItemsSource="{x:Bind Tasks, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </local:SoftCard>
        </DataTemplate>

        <DataTemplate x:Key="OverdueItemTemplate" x:DataType="local:OverdueRow">
            <Grid Padding="2,3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SoftMutedInkBrush}"
                    Text="{x:Bind DateText, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource SoftInkBrush}"
                    Text="{x:Bind Text, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource SoftMutedInkBrush}"
                    Text="{x:Bind CategoryLabel, Mode=OneTime}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InspirationGlanceTemplate" x:DataType="local:InspirationGlance">
            <Button
                MinWidth="0"
                MinHeight="32"
                Padding="2,3"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="编辑灵感"
                Background="Transparent"
                BorderThickness="0"
                Click="Inspiration_Click"
                CornerRadius="8"
                ToolTipService.ToolTip="点开后可以修改或删除">
                <Grid ColumnDefinitions="48,*" ColumnSpacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Text="{x:Bind TimeLabel, Mode=OneTime}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource SoftInkBrush}"
                        Text="{x:Bind Preview, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTaskInvoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" MinWidth="240" MaxWidth="280" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: date + horizontal progress like mock -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SoftCreamDeepBrush}"
            BorderBrush="{StaticResource SoftLineBrush}"
            BorderThickness="0,0,1,0"
            Padding="18,16,16,18">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="SideDateText"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SoftInkBrush}"
                        Text="10月15日 周四"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="SideWeekText"
                        FontSize="14"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Visibility="Collapsed"
                        Text="" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Foreground="#E8A06F" Glyph="&#xE706;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SoftInkBrush}"
                            Text="DayList" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="0">
                        <TextBlock
                            x:Name="PathText"
                            MaxWidth="148"
                            FontSize="11"
                            Foreground="{StaticResource SoftMutedInkBrush}"
                            Text="还没有连接库"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="SectionPrefix"
                            FontSize="11"
                            Foreground="{StaticResource SoftMutedInkBrush}"
                            Text=" · "
                            Visibility="Collapsed" />
                        <Border
                            x:Name="SectionTitleChrome"
                            Padding="4,1"
                            Background="Transparent"
                            CornerRadius="6"
                            Visibility="Collapsed"
                            PointerEntered="SectionTitleChrome_PointerEntered"
                            PointerExited="SectionTitleChrome_PointerExited"
                            Tapped="SectionTitle_Tapped"
                            ToolTipService.ToolTip="点击修改小节标题">
                            <Grid>
                                <TextBlock
                                    x:Name="SectionTitleText"
                                    FontSize="11"
                                    Foreground="{StaticResource SoftMutedInkBrush}"
                                    Text="DayList"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBox
                                    x:Name="SectionTitleBox"
                                    Style="{StaticResource QuietSectionTitleBoxStyle}"
                                    Visibility="Collapsed"
                                    KeyDown="SectionTitleBox_KeyDown"
                                    LostFocus="SectionTitleBox_LostFocus" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Progress: ring + labels side by side (mock) -->
                    <Grid Margin="0,18,0,4" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Grid
                            x:Name="SideProgressHost"
                            Width="72"
                            Height="72"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SideProgressHostScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <ProgressRing
                                x:Name="SideProgressRing"
                                Width="68"
                                Height="68"
                                Foreground="#5B9BD5"
                                IsIndeterminate="False"
                                Maximum="1"
                                Minimum="0"
                                Value="0" />
                            <TextBlock
                                x:Name="SideProgressPercent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SoftInkBrush}"
                                Text="0%" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource SoftMutedInkBrush}"
                                Text="今日进度" />
                            <TextBlock
                                x:Name="StatsText"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SoftInkBrush}"
                                Text="0 / 0 完成"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
                    <Button
                        x:Name="NavTodayButton"
                        Click="NavToday_Click"
                        Style="{StaticResource SoftNavButtonStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <FontIcon FontSize="15" Glyph="&#xE787;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="今日" />
                            <Border
                                Grid.Column="2"
                                MinWidth="22"
                                Padding="6,2"
                                Background="#33A89070"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="NavTodayCount"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource SoftMutedInkBrush}"
                                    Text="" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="NavDoneButton"
                        Click="NavDone_Click"
                        Style="{StaticResource SoftNavButtonStyle}"
                        ToolTipService.ToolTip="只看已经勾掉的任务，按分类排成列表，没有进度环。">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <FontIcon FontSize="15" Glyph="&#xE73E;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="已完成" />
                            <Border
                                Grid.Column="2"
                                MinWidth="22"
                                Padding="6,2"
                                Background="#33A89070"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="NavDoneCount"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource SoftMutedInkBrush}"
                                    Text="" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="InspirationButton"
                        Click="Inspiration_Click"
                        Style="{StaticResource SoftNavButtonStyle}"
                        ToolTipService.ToolTip="今日任务上方会列出当天已保存的灵感。点这里或点某一条，可以添加、修改或删除。不是待办，不进月报，也不参与生成计划。">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <FontIcon FontSize="15" Glyph="&#xEA80;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="灵感" />
                            <Border
                                Grid.Column="2"
                                MinWidth="22"
                                Padding="6,2"
                                Background="#33A89070"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="NavInspirationCount"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource SoftMutedInkBrush}"
                                    Text="" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="4">
                    <Grid>
                        <Button
                            x:Name="ReportSidebarButton"
                            HorizontalAlignment="Stretch"
                            Click="Report_Click"
                            Style="{StaticResource SoftNavButtonStyle}"
                            ToolTipService.ToolTip="汇总本月每日待办，生成 Markdown 月报到 Reports">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon x:Name="ReportSidebarIcon" FontSize="15" Glyph="&#xE9D2;" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="AI 本月总结" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <ProgressRing
                                    x:Name="ReportRing"
                                    Grid.Column="2"
                                    Width="16"
                                    Height="16"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Button
                        x:Name="PlanSidebarButton"
                        HorizontalAlignment="Stretch"
                        Click="Plan_Click"
                        Style="{StaticResource SoftNavButtonStyle}"
                        ToolTipService.ToolTip="用自然语言生成计划">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <FontIcon FontSize="15" Glyph="&#xE9F5;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="AI 生成计划" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="SidebarPickButton"
                        HorizontalAlignment="Stretch"
                        Click="Settings_Click"
                        Style="{StaticResource SoftNavButtonStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <FontIcon FontSize="15" Glyph="&#xE713;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="设置" />
                        </Grid>
                    </Button>
                </StackPanel>
</Grid>
        </Border>

        <!-- Main pane -->
        <Grid
            Grid.Column="1"
            Padding="22,14,22,16"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        x:Name="GreetingText"
                        MaxWidth="280"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Text="今天也是充实的一天。"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="PrevDayButton"
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="前一天"
                        Click="Prev_Click"
                        Style="{StaticResource QuietButtonStyle}"
                        ToolTipService.ToolTip="前一天">
                        <FontIcon FontSize="11" Foreground="{StaticResource SoftMutedInkBrush}" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        x:Name="DateButton"
                        Height="32"
                        MinWidth="0"
                        Padding="8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="10">
                        <Button.Content>
                            <TextBlock
                                x:Name="DateLabel"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource SoftInkBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout Placement="Bottom" FlyoutPresenterStyle="{StaticResource SoftFlyoutPresenterStyle}">
                                <!-- Dark chrome from SoftFlyoutPresenterStyle; light panel only under date grid -->
                                <Grid Width="320" Height="340">
                                    <Border
                                        Margin="4,88,4,4"
                                        Background="{StaticResource SoftCalendarDayBrush}"
                                        CornerRadius="8" />
                                    <CalendarView
                                        x:Name="DayCalendar"
                                        Width="320"
                                        Height="340"
                                        Style="{StaticResource SoftCalendarViewStyle}"
                                        CalendarIdentifier="GregorianCalendar"
                                        IsTodayHighlighted="True"
                                        Language="zh-Hans-CN"
                                        SelectedDatesChanged="DayCalendar_SelectedDatesChanged"
                                        SelectionMode="Single" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="NextDayButton"
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="后一天"
                        Click="Next_Click"
                        Style="{StaticResource QuietButtonStyle}"
                        ToolTipService.ToolTip="后一天">
                        <FontIcon FontSize="11" Foreground="{StaticResource SoftMutedInkBrush}" Glyph="&#xE76C;" />
                    </Button>
                    <Button
                        x:Name="TodayButton"
                        Height="28"
                        Padding="10,0"
                        Click="Today_Click"
                        Content="今天"
                        Visibility="Collapsed" />
                </StackPanel>
                <ToggleButton
                    x:Name="PinButton"
                    Grid.Column="1"
                    AutomationProperties.Name="置顶窗口"
                    Style="{StaticResource SoftPinToggleStyle}"
                    Click="Pin_Click"
                    ToolTipService.ToolTip="窗口置顶">
                    <FontIcon
                        x:Name="PinIcon"
                        FontSize="16"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Glyph="&#xE840;" />
                </ToggleButton>
                <Button
                    x:Name="ObsidianButton"
                    Grid.Column="2"
                    AutomationProperties.Name="在 Obsidian 中打开"
                    Click="Obsidian_Click"
                    IsEnabled="False"
                    Style="{StaticResource SoftIconButtonStyle}"
                    ToolTipService.ToolTip="在 Obsidian 中打开今日笔记">
                    <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                </Button>
                <Button
                    x:Name="ExplorerButton"
                    Grid.Column="3"
                    AutomationProperties.Name="在资源管理器中打开库"
                    Click="Explorer_Click"
                    IsEnabled="False"
                    Style="{StaticResource SoftIconButtonStyle}"
                    ToolTipService.ToolTip="在资源管理器中打开库">
                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                </Button>
</Grid>

            <StackPanel Grid.Row="1" Spacing="8">
                <Border
                    x:Name="SyncCapsule"
                    HorizontalAlignment="Left"
                    Padding="10,4"
                    Background="{StaticResource SoftCardBrush}"
                    BorderBrush="{StaticResource SoftLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            x:Name="SyncDot"
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{StaticResource SoftMutedInkBrush}" />
                        <TextBlock
                            x:Name="SyncLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource SoftMutedInkBrush}"
                            Text="已连接 Obsidian"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
                <InfoBar x:Name="StatusBar" Style="{StaticResource SoftInfoBarStyle}" IsClosable="True" IsOpen="False" />
                <InfoBar
                    x:Name="ExternalBar"
                    Style="{StaticResource SoftInfoBarStyle}"
                    Title="笔记被外部改动"
                    Closed="ExternalBar_Closed"
                    IsClosable="True"
                    IsOpen="False"
                    Message="Obsidian 或其他程序改了今日笔记。可以载入替换列表内容；关掉提示则在下次写入时写回。"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Click="LoadExternal_Click" Content="载入" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Border
                    x:Name="OverduePanel"
                    Padding="12,8"
                    Background="{StaticResource SoftAmberBrush}"
                    BorderBrush="#F0E6C8A0"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Background="Transparent"
                            ColumnDefinitions="Auto,Auto,*,Auto"
                            ColumnSpacing="8"
                            Tapped="OverdueHeader_Tapped">
                            <FontIcon
                                FontSize="14"
                                Foreground="{StaticResource SoftAmberInkBrush}"
                                Glyph="&#xE706;"
                                VerticalAlignment="Center" />
                            <FontIcon
                                x:Name="OverdueChevron"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource SoftAmberInkBrush}"
                                Glyph="&#xE76C;" />
                            <TextBlock
                                x:Name="OverdueTitle"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SoftAmberInkBrush}"
                                Text="昨天未完成"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Grid.Column="3"
                                MinWidth="240"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    x:Name="BringTodayButton"
                                    Click="MoveAllOverdue_Click"
                                    Content="带入今日"
                                    Style="{StaticResource SoftChipButtonStyle}"
                                    ToolTipService.ToolTip="把这些未完成项复制到今天。旧笔记的勾选不会改。" />
                                <Button
                                    x:Name="OverdueFilterButton"
                                    MinWidth="112"
                                    Click="OverdueFilter_Click"
                                    Style="{StaticResource SoftChipButtonStyle}"
                                    ToolTipService.ToolTip="按分类查看。全部会显示每一个未完成项。">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            x:Name="OverdueFilterLabel"
                                            MinWidth="32"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource SoftAmberInkBrush}"
                                            Text="全部"
                                            TextTrimming="None"
                                            TextWrapping="NoWrap" />
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource SoftAmberInkBrush}"
                                            Glyph="&#xE70D;" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="DismissOverdueButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    AutomationProperties.Name="今天不再提示"
                                    Click="DismissOverdue_Click"
                                    Style="{StaticResource QuietButtonStyle}"
                                    ToolTipService.ToolTip="今天不再提示这些未完成项">
                                    <FontIcon FontSize="11" Foreground="{StaticResource SoftAmberInkBrush}" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="OverdueList"
                            Grid.Row="1"
                            MaxHeight="180"
                            Background="Transparent"
                            BorderThickness="0"
                            IsItemClickEnabled="True"
                            ItemClick="OverdueList_ItemClick"
                            ItemTemplate="{StaticResource OverdueItemTemplate}"
                            SelectionMode="None"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid x:Name="WorkBody" Grid.Row="2" Visibility="Collapsed">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel Padding="0,6,4,8">
                        <local:SoftCard
                            x:Name="InspirationStrip"
                            Style="{StaticResource SoftLiftCardStyle}"
                            Visibility="Collapsed">
                            <Border
                                Background="{StaticResource SoftCardBrush}"
                                BorderBrush="{StaticResource SoftLineBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,12,14,8">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource SoftAmberInkBrush}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource SoftInkBrush}"
                                                Text="灵感" />
                                            <TextBlock
                                                x:Name="InspirationStripCount"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource SoftMutedInkBrush}" />
                                        </StackPanel>
                                        <Button
                                            x:Name="InspirationAddButton"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="添加灵感"
                                            Click="Inspiration_Click"
                                            Content="添加"
                                            Style="{StaticResource CategoryChipStyle}"
                                            ToolTipService.ToolTip="写一句再保存"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Grid
                                        x:Name="InspirationEmpty"
                                        Margin="0,2,0,4"
                                        ColumnDefinitions="Auto,Auto"
                                        ColumnSpacing="10"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource SoftMutedInkBrush}"
                                            Text="还没有灵感" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="添加灵感"
                                            Click="Inspiration_Click"
                                            Content="添加"
                                            Style="{StaticResource CategoryChipStyle}"
                                            ToolTipService.ToolTip="写一句再保存" />
                                    </Grid>
                                    <ScrollViewer
                                        x:Name="InspirationGlanceHost"
                                        MaxHeight="168"
                                        HorizontalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Enabled"
                                        Visibility="Collapsed">
                                        <ItemsControl
                                            x:Name="InspirationGlanceList"
                                            ItemTemplate="{StaticResource InspirationGlanceTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </local:SoftCard>
                        <ItemsControl
                            x:Name="CategoryCards"
                            ItemTemplate="{StaticResource CategoryCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel
                            x:Name="EmptyState"
                            MaxWidth="420"
                            Margin="8,36,8,12"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="EmptyHint"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource SoftMutedInkBrush}"
                                Text="今天还没有任务"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TemplateLead"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource SoftMutedInkBrush}"
                                Text="或点一个模板，写进当天笔记"
                                TextAlignment="Center"
                                Visibility="Collapsed" />
                            <StackPanel x:Name="TemplateHost" Spacing="8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border
                    x:Name="CelebrationBanner"
                    Margin="0,8,0,0"
                    Padding="16,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#F2FFFBF6"
                    BorderBrush="{StaticResource SoftLineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CelebrationText"
                        FontSize="13"
                        Foreground="{StaticResource SoftInkBrush}"
                        TextWrapping="NoWrap" />
                </Border>
            </Grid>

            <Border
                x:Name="Composer"
                Grid.Row="3"
                Margin="0,4,0,0"
                MinHeight="48"
                Style="{StaticResource SoftPillComposerStyle}"
                Visibility="Collapsed">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Glyph="&#xE710;" />
                    <TextBox
                        x:Name="AddBox"
                        Grid.Column="1"
                        MinHeight="36"
                        AcceptsReturn="False"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        KeyDown="AddBox_KeyDown"
                        PlaceholderText="添加任务…  明天 9 点 写周报 #工作"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="CategoryPicker"
                        Style="{StaticResource SoftComboBoxStyle}"
                        Grid.Column="2"
                        MinWidth="100"
                        MaxWidth="140"
                        Height="36"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        SelectionChanged="CategoryPicker_SelectionChanged"
                        ToolTipService.ToolTip="新任务分类" />
                </Grid>
            </Border>

            <!-- Hidden add click target kept for code compatibility if needed -->
            <Button
                x:Name="HiddenAddButton"
                Click="Add_Click"
                Visibility="Collapsed"
                Content="添加" />

            <StackPanel
                x:Name="WelcomePanel"
                Grid.Row="1"
                Grid.RowSpan="3"
                MaxWidth="440"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SoftInkBrush}"
                    Text="连接每日笔记" />
                <TextBlock
                    FontSize="14"
                    LineHeight="22"
                    Foreground="{StaticResource SoftMutedInkBrush}"
                    Text="DayList 不是另一套清单，它把待办写进 Obsidian 每日笔记的一个小节里，并用 ### 分类。"
                    TextWrapping="Wrap" />
                <Border
                    Padding="14,12"
                    Background="{StaticResource SoftCardBrush}"
                    BorderBrush="{StaticResource SoftLineBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        Foreground="{StaticResource SoftMutedInkBrush}"
                        Text="## DayList&#x0a;### 工作&#x0a;- [ ] 写周报&#x0a;  - [ ] 收集数据&#x0a;### 生活&#x0a;- [ ] 买牛奶" />
                </Border>
                <Button
                    HorizontalAlignment="Left"
                    Click="PickVault_Click"
                    Content="选择库文件夹"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
